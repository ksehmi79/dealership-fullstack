# Local PostgreSQL
DB_PASSWORD=replace-with-local-postgres-password

# Application security
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_PASSWORD=replace-with-admin-password
SALES_PASSWORD=replace-with-sales-password

# AWS / Amazon RDS deployment
RDS_DB_URL=jdbc:postgresql://your-rds-endpoint:5432/dealershipdb
RDS_DB_USERNAME=your-rds-username
RDS_DB_PASSWORD=replace-with-rds-password
